---
import BoatMark from "@/components/landing/BoatMark.astro";
import { NAV, SITE } from "@/lib/site";

const columns = [
  { heading: "Product", links: NAV },
  {
    heading: "Account",
    links: [
      { href: SITE.dashboard, label: "Dashboard" },
      { href: SITE.dashboard, label: "Sign in" },
      { href: SITE.dashboard, label: "Get started" },
    ],
  },
];
---

<footer class="border-t border-border px-6 py-12 sm:px-10 lg:py-16">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5">
      <div class="flex items-center gap-2.5">
        <BoatMark class="h-5 w-auto shrink-0 text-primary" />
        <span class="font-heading text-base font-semibold tracking-[-0.01em]">Paperboat</span>
      </div>
      <p class="text-body-sm mt-4 max-w-[38ch] text-muted-foreground">
        {SITE.tagline} Hosted environments and your own machines, reached through
        one durable terminal.
      </p>
    </div>

    {
      columns.map((column) => (
        <nav class="lg:col-span-3" aria-label={column.heading}>
          <h2 class="text-eyebrow text-muted-foreground">{column.heading}</h2>
          <ul class="mt-4 space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-body-sm rounded-sm transition-colors outline-none hover:text-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <p class="text-caption mt-12 border-t border-border pt-6 text-muted-foreground">
    © {new Date().getFullYear()} Paperboat. Plans, credits, storage, machine types,
    and idle timeouts are configured in the dashboard.
  </p>
</footer>
