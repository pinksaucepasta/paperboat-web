---
/**
 * The real `pb` flow: type `pb`, pick a machine, pick what to do on it, land in
 * the session that was already running there.
 *
 * Both choosers mirror `paperboat-cli` (`internal/selector/selector.go`, driven
 * from `cmd/pb/main.go`) rather than an invented list — the brand-coloured title
 * over a faint subtitle, two lines per item (name, then detail), a `  >  ` gutter
 * only the current row fills, the filter bar, and the real footer. Selection is
 * reverse video there, so it is an inverted bar here. The second chooser is
 * `chooseMachineHomeAction`, titled with the machine and its status summary.
 *
 * The chooser runs in the alternate screen, so each step *replaces* the last
 * rather than scrolling above it. The screens are stacked in one fixed-height
 * box and cross-faded, which is both what the terminal does and what keeps the
 * card the height of its tallest screen instead of the sum of all three.
 *
 * Motion is CSS only — no emulator, no script, no hydration — animating colour,
 * opacity and one width over a fixed layout, so nothing reflows. Under
 * `prefers-reduced-motion` the screens un-stack into one plain transcript with
 * every step visible at once, which reads better held still than a cross-fade
 * frozen on its last frame.
 */
const machines = [
  { name: "studio-mbp", status: "Online  ·  Host" },
  { name: "anvit-rpi", status: "Online  ·  Host" },
  { name: "acme-api", status: "Online  ·  Host" },
];

/**
 * From `machineHomeActions`, in source order — except the Claude row, which the
 * CLI does not offer yet (it ships `Create Codex session`). It reads as a
 * reattach rather than a create because the session in the next screen is
 * already running: that is the durable-session claim this section makes.
 */
const actions = [
  { name: "Create terminal session", detail: "Start and attach to a new durable session" },
  { name: "Claude session", detail: "Reattach to the Claude session already running here" },
  { name: "Send files", detail: "Search, select, drop, or paste files for this machine" },
  { name: "Create preview", detail: "Publish an application port from this machine" },
  { name: "Sessions", detail: "List durable terminal sessions on this machine" },
];

const FOOTER = "↑/↓ move  enter open  ctrl+f favorite  esc back";

/**
 * Turns restored from the durable session. There is more here than fits, which
 * is the point: the history scrolls under a prompt that stays put.
 */
const history = [
  { kind: "you", text: "add rate limiting to the upload route" },
  { kind: "act", text: "Read(src/routes/upload.ts)" },
  { kind: "res", text: "Read 132 lines" },
  { kind: "act", text: "Update(src/routes/upload.ts)" },
  { kind: "res", text: "Updated 24 additions, 2 removals" },
  { kind: "say", text: "Added a token bucket at 20 req/min per key." },
  { kind: "gap", text: "" },
  { kind: "you", text: "now cover it with a test" },
  { kind: "act", text: "Write(test/upload.rate.test.ts)" },
  { kind: "res", text: "Wrote 48 lines" },
  { kind: "act", text: "Bash(pnpm test upload)" },
  { kind: "res", text: "6 passed in 1.2s" },
  { kind: "say", text: "Green — the limiter rejects the 21st request." },
  { kind: "gap", text: "" },
  { kind: "you", text: "refactor the token refresh to retry twice" },
  { kind: "act", text: "Update(src/auth/refresh.ts)" },
  { kind: "res", text: "Updated 1 addition, 1 removal" },
  { kind: "say", text: "Refresh now retries twice with backoff." },
];
---

<div class="overflow-hidden rounded-lg border border-border bg-card">
  <div class="flex items-center gap-3 border-b border-border bg-muted px-4 py-2.5">
    <span class="text-eyebrow text-muted-foreground">Session</span>
    <span class="font-mono text-xs text-muted-foreground">anvit-rpi · claude-1</span>
    <span class="ml-auto flex items-center gap-1.5">
      <span class="size-1.5 rounded-full bg-success" aria-hidden="true"></span>
      <span class="font-mono text-xs text-muted-foreground">attached</span>
    </span>
  </div>

  <!-- Not a `<pre>`: the transcript's alignment lives in each line's own
       `whitespace-pre`, so the template's indentation can never leak into the
       rendered output as blank lines. -->
  <div
    data-pb-stack
    class="pb-stack overflow-x-auto font-mono text-xs leading-[1.9] sm:text-[0.8125rem]"
  >
    {/* 1 — `pb` is typed, then the machine chooser opens over it. */}
    <div class="pb-screen pb-screen-1">
      <div class="whitespace-pre">
        <span class="text-muted-foreground select-none">$ </span><span
          class="pb-type inline-block overflow-hidden align-bottom text-foreground">pb</span
        ><span class="pb-caret-type bg-primary select-none" aria-hidden="true">{" "}</span>
      </div>
      <div class="h-[1.9em]"></div>

      <div class="pb-chooser">
        <div class="whitespace-pre font-semibold text-primary">Machines</div>
        <div class="whitespace-pre text-muted-foreground">Paired computers</div>
        <div class="h-[1.9em]"></div>
        {
          machines.map((machine, i) => (
            <>
              <div class:list={["pb-row whitespace-pre", i < 2 && `pb-a${i}`]}>
                {i === 1 && <span class="sr-only">selected: </span>}
                <span class="pb-mark select-none">{"  >  "}</span>{machine.name}
              </div>
              <div class="whitespace-pre text-muted-foreground">{"     " + machine.status}</div>
            </>
          ))
        }
        <div class="whitespace-pre font-semibold text-primary">{"     + Add machine"}</div>
        <div class="whitespace-pre text-muted-foreground">{"     Set up another computer"}</div>
        <div class="h-[1.9em]"></div>
        <div class="whitespace-pre">
          <span class="rounded-[2px] bg-foreground/90 px-1 text-background">Filter</span>
        </div>
        <div class="whitespace-pre text-muted-foreground/70">{FOOTER}</div>
      </div>
    </div>

    {/* 2 — choosing the machine replaces the screen with its action chooser. */}
    <div class="pb-screen pb-screen-2">
      <div class="whitespace-pre font-semibold text-primary">anvit-rpi</div>
      <div class="whitespace-pre text-muted-foreground">Online  ·  Host</div>
      <div class="h-[1.9em]"></div>
      {
        actions.map((action, i) => (
          <>
            <div class:list={["pb-row whitespace-pre", i < 2 && `pb-b${i}`]}>
              {i === 1 && <span class="sr-only">selected: </span>}
              <span class="pb-mark select-none">{"  >  "}</span>{action.name}
            </div>
            <div class="whitespace-pre text-muted-foreground">{"     " + action.detail}</div>
          </>
        ))
      }
      <div class="h-[1.9em]"></div>
      <div class="whitespace-pre">
        <span class="rounded-[2px] bg-foreground/90 px-1 text-background">Filter</span>
      </div>
      <div class="whitespace-pre text-muted-foreground/70">{FOOTER}</div>
    </div>

    {/* 3 — Claude Code, mid-session: banner pinned at the top, restored turns
           scrolling between, and the prompt held at the bottom of the shell. */}
    <div class="pb-screen pb-screen-3 flex flex-col">
      <div class="flex shrink-0 items-center gap-3">
        <svg
          viewBox="0 0 24 24"
          class="h-[5.1em] w-[5.1em] shrink-0"
          shape-rendering="crispEdges"
          aria-hidden="true"
        >
          <path
            clip-rule="evenodd"
            d="M20.998 10.949H24v3.102h-3v3.028h-1.487V20H18v-2.921h-1.487V20H15v-2.921H9V20H7.488v-2.921H6V20H4.487v-2.921H3V14.05H0V10.95h3V5h17.998v5.949zM6 10.949h1.488V8.102H6v2.847zm10.51 0H18V8.102h-1.49v2.847z"
            fill="#D97757"
            fill-rule="evenodd"></path>
        </svg>
        <div class="min-w-0">
          {/* The space before the version is an explicit string: written as
              literal whitespace between the spans, the formatter eats it. */}
          <div class="whitespace-pre"
            ><span class="font-semibold text-foreground">Claude Code</span><span
              class="text-muted-foreground">{" v2.1.212"}</span
            ></div
          >
          <div class="whitespace-pre text-muted-foreground"
            >Opus 4.8 (1M context) · API Usage Billing</div
          >
          <div class="whitespace-pre text-muted-foreground">~/acme-api</div>
        </div>
      </div>

      <div class="pb-history min-h-0 flex-1 overflow-y-auto py-[1.9em]">
        {
          history.map((line) =>
            line.kind === "gap" ? (
              <div class="h-[1.9em]"></div>
            ) : line.kind === "you" ? (
              <div class="whitespace-pre">
                <span class="text-muted-foreground select-none">{"> "}</span>
                <span class="text-foreground">{line.text}</span>
              </div>
            ) : line.kind === "res" ? (
              <div class="whitespace-pre text-muted-foreground">{"  ⎿  " + line.text}</div>
            ) : (
              <div class="whitespace-pre">
                <span class="text-primary select-none">{"⏺ "}</span>
                <span class="text-foreground">{line.text}</span>
              </div>
            ),
          )
        }
      </div>

      {/* The cursor is a real space with a background rather than a sized box:
          `1ch` is the width of a zero, a hair off this font's advance width,
          which left the box's right edge short of the rows above and below. */}
      <div class="shrink-0">
        <div class="whitespace-pre text-muted-foreground/70"
          >╭──────────────────────────────────────────────╮</div
        >
        <div class="whitespace-pre"
          ><span class="text-muted-foreground/70 select-none">│ </span><span
            class="text-muted-foreground select-none">{"> "}</span
          ><span class="pb-cursor bg-primary select-none" aria-hidden="true">{" "}</span
          ><span class="text-muted-foreground/70 select-none">{" ".repeat(42) + "│"}</span></div
        >
        <div class="whitespace-pre text-muted-foreground/70"
          >╰──────────────────────────────────────────────╯</div
        >
        <div class="whitespace-pre text-muted-foreground/70">{"  ? for shortcuts"}</div>
      </div>
    </div>
  </div>
</div>

<script>
  /**
   * Hold the transcript at its first frame until it is actually on screen, so
   * the run starts from `$ ` being typed rather than halfway through a chooser.
   *
   * This is the one thing here CSS cannot do: `animation-timeline: view()` ties
   * progress to scroll position — it scrubs the sequence as the page moves —
   * where this needs a normal time-based clock that simply has not started yet.
   *
   * It fails open. The paused attribute is only ever set by this script, so if
   * it never runs, or `IntersectionObserver` is missing, the animations play on
   * load exactly as they did before — the degraded state is the old behaviour,
   * not a frozen card. Leaving the viewport pauses rather than resets, so
   * scrolling back does not restart the sequence under the reader.
   */
  const stack = document.querySelector<HTMLElement>("[data-pb-stack]");

  if (stack && typeof IntersectionObserver === "function") {
    stack.dataset.pbPaused = "";

    new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) delete stack.dataset.pbPaused;
          else stack.dataset.pbPaused = "";
        }
      },
      { threshold: 0.2 },
    ).observe(stack);
  }
</script>

<style>
  /* Every animation on the card hangs off this one gate. */
  [data-pb-paused] :is(.pb-screen, .pb-row, .pb-mark, .pb-chooser, .pb-type, .pb-caret-type, .pb-cursor) {
    animation-play-state: paused;
  }

  /* The three screens occupy one box, tallest wins, and cross-fade in place —
     the chooser's alternate screen replaces rather than scrolls. */
  .pb-stack {
    position: relative;
    min-height: calc(30.4em + 2rem);
  }
  .pb-screen {
    position: absolute;
    inset: 0;
    padding: 1rem;
  }
  @media (min-width: 40rem) {
    .pb-screen {
      padding: 1rem 1.25rem;
    }
  }

  /* Rows that are never the current one carry no animation, so the gutter has
     to default to hidden — otherwise every unselected row shows a `>` too. */
  .pb-mark {
    opacity: 0;
  }

  /* A quiet scrollbar: the history is the only scrollable thing on the card. */
  .pb-history {
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
    overscroll-behavior: contain;
  }

  /* One 16s clock, no `animation-delay` anywhere: a delayed row shows its
     unanimated state until its delay elapses — which lights every caret at once
     on load — and offset cycles drift apart at the loop seam. Each row spells
     out its own windows against the same clock instead. */
  .pb-screen,
  .pb-row,
  .pb-mark,
  .pb-chooser,
  .pb-type,
  .pb-caret-type {
    animation-duration: 16s;
    animation-timing-function: step-end;
    animation-iteration-count: infinite;
  }
  .pb-screen-1 { animation-name: pb-screen-1; }
  .pb-screen-2 { animation-name: pb-screen-2; }
  .pb-screen-3 { animation-name: pb-screen-3; }

  /* `pb` is typed a character at a time, then the chooser opens over it. */
  .pb-type {
    animation-name: pb-type;
    animation-timing-function: steps(2, end);
    width: 2ch;
  }
  .pb-caret-type { animation-name: pb-caret-type; }
  .pb-chooser { animation-name: pb-chooser; }

  @keyframes pb-type {
    0% { width: 0; }
    5%, 100% { width: 2ch; }
  }
  @keyframes pb-caret-type {
    0% { opacity: 1; }
    8%, 100% { opacity: 0; }
  }
  @keyframes pb-chooser {
    0% { opacity: 0; }
    8%, 100% { opacity: 1; }
  }

  .pb-a0 { animation-name: pb-a0; }
  .pb-a1 { animation-name: pb-a1; }
  .pb-b0 { animation-name: pb-b0; }
  .pb-b1 { animation-name: pb-b1; }
  .pb-a0 .pb-mark { animation-name: pb-m-a0; }
  .pb-a1 .pb-mark { animation-name: pb-m-a1; }
  .pb-b0 .pb-mark { animation-name: pb-m-b0; }
  .pb-b1 .pb-mark { animation-name: pb-m-b1; }

  @keyframes pb-screen-1 { 0% { opacity: 1; } 30%, 100% { opacity: 0; } }
  @keyframes pb-screen-2 { 0% { opacity: 0; } 32% { opacity: 1; } 62%, 100% { opacity: 0; } }
  @keyframes pb-screen-3 { 0% { opacity: 0; } 64%, 100% { opacity: 1; } }

  /* Reverse video, the way the chooser draws its current row. */
  @keyframes pb-a0 {
    0% { background-color: var(--foreground); color: var(--background); }
    16%, 100% { background-color: transparent; color: inherit; }
  }
  @keyframes pb-a1 {
    0% { background-color: transparent; color: inherit; }
    16%, 100% { background-color: var(--foreground); color: var(--background); }
  }
  @keyframes pb-b0 {
    0% { background-color: var(--foreground); color: var(--background); }
    44%, 100% { background-color: transparent; color: inherit; }
  }
  @keyframes pb-b1 {
    0% { background-color: transparent; color: inherit; }
    44%, 100% { background-color: var(--foreground); color: var(--background); }
  }
  @keyframes pb-m-a0 { 0% { opacity: 1; } 16%, 100% { opacity: 0; } }
  @keyframes pb-m-a1 { 0% { opacity: 0; } 16%, 100% { opacity: 1; } }
  @keyframes pb-m-b0 { 0% { opacity: 1; } 44%, 100% { opacity: 0; } }
  @keyframes pb-m-b1 { 0% { opacity: 0; } 44%, 100% { opacity: 1; } }

  .pb-cursor {
    animation: pb-blink 1.1s step-end infinite;
  }
  @keyframes pb-blink {
    0%, 50% { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pb-screen,
    .pb-row,
    .pb-mark,
    .pb-chooser,
    .pb-type,
    .pb-caret-type,
    .pb-cursor {
      animation: none;
    }
    /* Un-stack into one plain transcript: every step visible, nothing hidden. */
    .pb-stack {
      min-height: 0;
    }
    .pb-screen {
      position: static;
      inset: auto;
      opacity: 1;
    }
    .pb-screen-2,
    .pb-screen-3 {
      margin-top: 1.9em;
    }
    /* Held still there is nothing to scroll past, so let the history run full
       height rather than trapping it in a scroller the reader cannot see into. */
    .pb-screen-3 {
      display: block;
    }
    .pb-history {
      overflow: visible;
    }
    .pb-caret-type {
      opacity: 0;
    }
    .pb-a1 .pb-mark,
    .pb-b1 .pb-mark {
      opacity: 1;
    }
    .pb-a1,
    .pb-b1 {
      background-color: var(--foreground);
      color: var(--background);
    }
  }
</style>
